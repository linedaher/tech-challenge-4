{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "v08barChart",
  "position": {
    "x": 20,
    "y": 165,
    "z": 8000,
    "height": 300,
    "width": 620,
    "tabOrder": 8000
  },
  "visual": {
    "visualType": "barChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fReviewTema"
                    }
                  },
                  "Property": "tema"
                }
              },
              "queryRef": "fReviewTema.tema",
              "nativeQueryRef": "tema"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Medidas"
                    }
                  },
                  "Property": "Menções"
                }
              },
              "queryRef": "_Medidas.Menções",
              "nativeQueryRef": "Menções"
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fReview"
                    }
                  },
                  "Property": "sentimento"
                }
              },
              "queryRef": "fReview.sentimento",
              "nativeQueryRef": "sentimento"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Measure": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "_Medidas"
                  }
                },
                "Property": "Menções"
              }
            },
            "direction": "Descending"
          }
        ],
        "isDefaultSort": false
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Temas mais citados, por sentimento'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "11D"
                }
              }
            }
          }
        }
      ]
    }
  }
}