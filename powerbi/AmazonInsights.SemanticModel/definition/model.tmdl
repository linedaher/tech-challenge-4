model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["dProduto","fReview","fReviewTema","PastaDados","CotacaoINRBRL"]

annotation PBI_ProTooling = ["DevMode"]

ref table dProduto
ref table fReview
ref table fReviewTema
ref table dRecomendacao
ref table _Medidas

ref cultureInfo pt-BR

